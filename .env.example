# Copy to .env and fill in real values. Never commit .env.
DEEPSEEK_API_KEY=your-key-here
DEEPSEEK_MODEL=deepseek-chat
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/postgres
MEMORY_DB_DSN=postgresql://postgres:postgres@localhost:5432/postgres
CLINICAL_DATA_EXTERNAL_LLM_CONSENT=false
DB_ENCRYPTION_KEY=base64-encoded-32-byte-key
PROFILE_HASH_SALT=change-me
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
LLM_PROVIDER=deepseek
LLM_CALL_TIMEOUT_SECONDS=20
RETRIEVAL_INTERNAL_MAX_RETRIES=1
MAX_TRIALS_FOR_ELIGIBILITY=10
MAX_TRIALS_PER_QUERY=10
TAVILY_API_KEY=your-key-here
TAVILY_ENABLE_CTGOV_SUPPLEMENT=true
TAVILY_MAX_RESULTS=3
TAVILY_MAX_TRIALS_TO_ENRICH=8
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_MODEL=llama3.1
LANGCHAIN_TRACING_V2=true
